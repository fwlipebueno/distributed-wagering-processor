{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "start": "bun dist/src/main.js",
    "dev": "bun src/main.ts",
    "migrate": "bun src/infrastructure/migrate.ts up",
    "migrate:down": "bun src/infrastructure/migrate.ts down",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 120000 tests/integration",
    "test:load": "bun scripts/load.ts",
    "demo": "bun scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1010.0",
    "@mikro-orm/core": "6.6.8",
    "@mikro-orm/migrations": "6.6.8",
    "@mikro-orm/postgresql": "6.6.8",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.10",
    "@types/express": "5.0.3",
    "typescript": "5.9.3"
  }
}
